# Copy to .env for local development. Names only: never commit real values.
# Full list and meaning: docs/ARCHITECTURE.md §10. Validated by src/server/platform/config.ts.

NODE_ENV=development
APP_URL=http://localhost:3000

# docker compose `db` service
DATABASE_URL=postgres://levelset:levelset@localhost:5432/levelset
# Neon: direct (unpooled) URL for migrations
DATABASE_URL_UNPOOLED=

# stripe | fake (fake is refused when NODE_ENV=production)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Provider price IDs only; amounts live in the provider dashboard, never in this repo
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_ANNUAL=price_replace_me
STRIPE_ALLOW_LIVE=false

# Licence tokens (milestone 3): JWK set of Ed25519 private keys + active key id
LICENSE_SIGNING_KEYS=
LICENSE_ACTIVE_KID=
# At least 32 random characters each
KEY_HASH_PEPPER=
SESSION_SECRET=

# console | resend | acs
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
# Comma-separated; bootstraps the Owner role
OWNER_EMAILS=
# Comma-separated snake_case feature names granted by Pro plans (synced to plans by the seed job)
PRO_FEATURES=

TOKEN_TTL_DAYS=7
TOKEN_REFRESH_HOURS=24
DEFAULT_DEVICE_LIMIT=2
TRANSFER_COOLDOWN_HOURS=24
TRIAL_DAYS=0
AUDIT_RETENTION_YEARS=5
DEVICE_PURGE_MONTHS=12

FLAG_TRIALS=false
FLAG_SELF_SERVE_TRANSFER=true
